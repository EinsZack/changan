{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "thor3-runtime3-probe-20261113",
    "namespace": "changan",
    "labels": {
      "app": "changan-thor-probe",
      "changan.io/validation": "thor3-20261113"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 1800,
    "runtimeClassName": "nvidia",
    "automountServiceAccountToken": false,
    "nodeSelector": {
      "kubernetes.io/hostname": "thor3",
      "kubernetes.io/arch": "arm64"
    },
    "securityContext": {
      "runAsUser": 10001,
      "runAsGroup": 10001,
      "runAsNonRoot": true,
      "supplementalGroups": [
        44,
        993
      ],
      "fsGroup": 10001,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "probe",
        "image": "192.168.50.231:5500/changan/video-thor@sha256:7e82d8c1d4f5fe1ccd515fd0adf8d4bd2f7d10ee9a13f8b43b886c4fddf1b7dc",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "python",
          "-u",
          "-c"
        ],
        "args": [
          "import runpy,pathlib,cv2,numpy,onnxruntime,sys,platform; print('VERSIONS='+str({'python':sys.version,'machine':platform.machine(),'cv2':cv2.__version__,'numpy':numpy.__version__,'ort':onnxruntime.__version__}),flush=True); runpy.run_path('/opt/diagnostics/cpu_gpu_probe.py',run_name='__main__'); print('MEMORY_PEAK='+pathlib.Path('/sys/fs/cgroup/memory.peak').read_text())"
        ],
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "2Gi",
            "nvidia.com/gpu": "1"
          },
          "limits": {
            "cpu": "2",
            "memory": "2Gi",
            "nvidia.com/gpu": "1"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "env": [
          {
            "name": "CUDA_CACHE_PATH",
            "value": "/cache/cuda"
          },
          {
            "name": "CUDA_CACHE_MAXSIZE",
            "value": "1073741824"
          },
          {
            "name": "POD_NAME",
            "valueFrom": {
              "fieldRef": {
                "fieldPath": "metadata.name"
              }
            }
          },
          {
            "name": "NODE_NAME",
            "valueFrom": {
              "fieldRef": {
                "fieldPath": "spec.nodeName"
              }
            }
          }
        ],
        "volumeMounts": [
          {
            "name": "tmp",
            "mountPath": "/tmp"
          },
          {
            "name": "cache",
            "mountPath": "/cache/cuda"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "tmp",
        "emptyDir": {
          "sizeLimit": "128Mi"
        }
      },
      {
        "name": "cache",
        "hostPath": {
          "path": "/var/lib/rancher/k3s/changan-cache/cuda",
          "type": "Directory"
        }
      }
    ]
  }
}
