# Copy selected settings into .env; configure_dev_cluster.py fills development addresses.
CHANGAN_BACKEND=k3s
CHANGAN_KUBECONFIG=/root/projects/changan-orchestrator/data/k3s/orchestrator.yaml
CHANGAN_NAMESPACE=changan
CHANGAN_CLUSTER_ID=changan-dev
CHANGAN_IMAGE_ARCH=amd64
# Replace with the digest output by build_video_image.py.
CHANGAN_VIDEO_IMAGE=changan-registry:5000/changan/video-unified@sha256:REPLACE_WITH_VERIFIED_DIGEST
CHANGAN_CONTAINER_HOST=172.29.1.1
CHANGAN_CONTAINER_BASE=http://172.29.1.1:8311
# CHANGAN_IMAGE_PULL_SECRET=precreated-registry-credential
CHANGAN_ENVIRONMENT_NOTE=同一开发服务器的4个K3s逻辑节点；未完成THOR实机验证

# 模型初始化策略；正常使用auto，同一通用容器可选择CPU/CUDA。
# cpu/cuda仅供运维验证，任务提交不需要选择专用节点。
CHANGAN_MODEL_DEVICE=auto
CHANGAN_MODEL_GPU_DEVICE_ID=0

# 节点本地CUDA JIT编译缓存（RTX 5090上ORT CUDA12算子需PTX JIT，冷启动约55~78秒）。
# 先运行 python scripts/prepare_cuda_cache.py prepare 创建UID 10001可写目录，再设置下行并重启API。
# 留空时每个Pod使用临时缓存，跨任务不复用。
# CHANGAN_CUDA_CACHE_HOSTPATH=/var/lib/rancher/k3s/changan-cache/cuda
# CHANGAN_CUDA_CACHE_MAX_BYTES=1073741824
