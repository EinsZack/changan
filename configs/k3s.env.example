# Copy selected settings into .env; configure_dev_cluster.py fills development addresses.
CHANGAN_BACKEND=k3s
CHANGAN_KUBECONFIG=/root/projects/changan-orchestrator/data/k3s/orchestrator.yaml
CHANGAN_NAMESPACE=changan
CHANGAN_CLUSTER_ID=changan-dev
CHANGAN_IMAGE_ARCH=amd64
# Replace with the digest output by build_video_image.py.
CHANGAN_VIDEO_IMAGE=changan-registry:5000/changan/video@sha256:REPLACE_WITH_VERIFIED_DIGEST
CHANGAN_CONTAINER_HOST=172.29.1.1
CHANGAN_CONTAINER_BASE=http://172.29.1.1:8311
# CHANGAN_IMAGE_PULL_SECRET=precreated-registry-credential
CHANGAN_ENVIRONMENT_NOTE=同一开发服务器的4个K3s逻辑节点；未完成THOR实机验证
