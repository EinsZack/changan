[Unit]
Description=Changan orchestration API (single coordinator)
After=network.target
[Service]
Type=simple
WorkingDirectory=/root/projects/changan-orchestrator
EnvironmentFile=-/root/projects/changan-orchestrator/.env
ExecStart=/root/miniforge3/envs/changan-orchestrator/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8310 --no-access-log
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
