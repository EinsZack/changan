# Select a validated backend explicitly. CPU and CUDA have separate immutable image refs.
CHANGAN_DEFAULT_INFERENCE_BACKEND=cuda
CHANGAN_CUDA_IMAGE_ARCH=amd64
CHANGAN_VIDEO_CUDA_IMAGE=registry/changan/video-cuda@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Add only AFTER real ARM64 board and image validation:
# CHANGAN_VIDEO_CUDA_IMAGE_ARM64=registry/changan/video-cuda-arm64@sha256:REPLACE_WITH_VERIFIED_DIGEST
# CHANGAN_VIDEO_IMAGE_ARM64=registry/changan/video-cpu-arm64@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Development server only. Actual boards publish telemetry locally or through the resource pool.
CHANGAN_GPU_TELEMETRY=server
