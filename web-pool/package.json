{
  "name": "vehicle-compute-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:dashboard": "node --experimental-strip-types --test tests/dashboardModel.test.mjs tests/resourceAggregation.test.mjs tests/clusterRecovery.test.mjs",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
