# Preparation template only. Fill both digest and dependency lock after real board preflight.
# Select a vendor-supported ARM64 image for the actual Jetson/DRIVE OS release.
ARG BOARD_BASE_IMAGE
FROM ${BOARD_BASE_IMAGE}
WORKDIR /opt/app
# The lock MUST match board Python, CUDA and cuDNN. Do not reuse amd64 CUDA wheels.
COPY board-requirements.lock.txt /tmp/requirements.txt
COPY board-wheels/ /tmp/wheels/
RUN python3 -m pip install --no-index --find-links=/tmp/wheels -r /tmp/requirements.txt && rm -rf /tmp/wheels
COPY workers/__init__.py workers/inference.py workers/gpu.py workers/container_entry.py workers/attempt_entry.py ./workers/
COPY assets/models/yolox_tiny.onnx /opt/model/yolox_tiny.onnx
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 NVIDIA_DRIVER_CAPABILITIES=compute,utility
USER 10001:10001
ENTRYPOINT ["python3","-m","workers.container_entry"]
