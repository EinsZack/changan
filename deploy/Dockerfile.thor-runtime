# Build on the x86_64 development server through explicit user-mode emulation.
# QEMU exists only in the dependency stage; the result is native Linux ARM64.
FROM python:3.12-slim-trixie@sha256:c61cffc3bacb94ed026ff8b45d5114b7693dd0420baca0a1ace0e3d0ce9035fd AS dependencies
COPY qemu-aarch64-static /qemu
COPY wheels /wheels
COPY requirements.txt /tmp/requirements.txt
RUN ["/qemu", "/usr/local/bin/python", "-m", "pip", "install", "--no-cache-dir", "--no-compile", "--no-index", "--find-links=/wheels", "-r", "/tmp/requirements.txt"]
FROM python:3.12-slim-trixie@sha256:c61cffc3bacb94ed026ff8b45d5114b7693dd0420baca0a1ace0e3d0ce9035fd
COPY --from=dependencies /usr/local /usr/local
WORKDIR /opt/app
COPY workers ./workers/
COPY model.onnx /opt/model/yolox_tiny.onnx
COPY cpu_gpu_probe.py /opt/diagnostics/cpu_gpu_probe.py
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 NVIDIA_DRIVER_CAPABILITIES=compute,utility
# CUDA 13 wheels use cu13/lib, which ORT 1.24 preload_dlls does not discover.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cu13/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib
USER 10001:10001
ENTRYPOINT ["python","-m","workers.container_entry"]
