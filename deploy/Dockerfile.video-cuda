# Server amd64 CUDA image. THOR uses a separately validated ARM64/L4T image digest.
FROM python:3.11-slim-bookworm@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39 AS dependencies
WORKDIR /opt/app
COPY wheels /wheels
COPY requirements-video-cuda.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r /tmp/requirements.txt && rm -rf /wheels
FROM python:3.11-slim-bookworm@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39
COPY --from=dependencies /usr/local /usr/local
WORKDIR /opt/app
COPY workers/__init__.py workers/inference.py workers/gpu.py workers/container_entry.py workers/attempt_entry.py ./workers/
COPY assets/models/yolox_tiny.onnx /opt/model/yolox_tiny.onnx
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 NVIDIA_DRIVER_CAPABILITIES=compute,utility
USER 10001:10001
ENTRYPOINT ["python","-m","workers.container_entry"]
